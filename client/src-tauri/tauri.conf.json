{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forever Addon Manager",
  "version": "0.1.0",
  "identifier": "com.christianpresley.forever-addon-manager",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Forever Addon Manager",
        "width": 1120,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560,
        "backgroundColor": "#14161a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
